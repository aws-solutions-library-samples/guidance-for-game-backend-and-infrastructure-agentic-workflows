# Backend Environment - role models
# Defaults are shown. Canonical role variables take precedence over legacy aliases.
GBAW_ORCHESTRATOR_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
GBAW_SPECIALIST_MODEL_ID=global.anthropic.claude-sonnet-4-6
# GBAW_BEDROCK_MODEL_ID=
# GBAW_BEDROCK_MODEL_ID_SECONDARY=

# Knowledge Base IDs (auto-populated by deploy-kb.sh)
GBAW_GAMELIFT_KB_ID=your-gamelift-kb-id
GBAW_EKS_KB_ID=your-eks-kb-id
GBAW_COST_KB_ID=your-cost-kb-id

