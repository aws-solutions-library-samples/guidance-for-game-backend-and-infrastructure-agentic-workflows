# Backend Environment - role models
# Leave these commented to use the defaults from backend/src/config/model_settings.py.
# Uncomment and set a value only to override a role. Canonical role variables
# take precedence over the legacy aliases.
# GBAW_ORCHESTRATOR_MODEL_ID=
# GBAW_SPECIALIST_MODEL_ID=
# GBAW_BEDROCK_MODEL_ID=
# GBAW_BEDROCK_MODEL_ID_SECONDARY=

# Knowledge Base IDs (auto-populated by deploy-kb.sh)
GBAW_GAMELIFT_KB_ID=your-gamelift-kb-id
GBAW_EKS_KB_ID=your-eks-kb-id
GBAW_COST_KB_ID=your-cost-kb-id

# Optional: Prompt ARNs (auto-populated by deploy-prompts.sh)
# GBAW_ORCHESTRATOR_PROMPT_ARN=
# GBAW_GAMELIFT_PROMPT_ARN=
# GBAW_EKS_PROMPT_ARN=
# GBAW_COST_PROMPT_ARN=
