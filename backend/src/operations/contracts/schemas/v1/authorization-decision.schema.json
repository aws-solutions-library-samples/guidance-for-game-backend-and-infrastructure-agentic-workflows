{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:game-agent:operations:contracts:v1:authorization-decision",
  "title": "Authorization Decision 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorization_contract_version",
    "decision_id",
    "operation_id",
    "prepared_operation_hash",
    "principal",
    "authority_inputs",
    "effective_authority",
    "decision",
    "reason_codes",
    "policy_version",
    "evaluated_at",
    "expires_at",
    "correlation"
  ],
  "properties": {
    "authorization_contract_version": {
      "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/contract_version"
    },
    "decision_id": {
      "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/identifier"
    },
    "operation_id": {
      "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/operation_id"
    },
    "prepared_operation_hash": {
      "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/digest"
    },
    "principal": {
      "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/trusted_identity"
    },
    "authority_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deployment_mode",
        "tenant_policy",
        "workspace_policy",
        "principal_authority",
        "capability_maximum",
        "operation_risk_policy"
      ],
      "properties": {
        "deployment_mode": {
          "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/authority"
        },
        "tenant_policy": {
          "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/authority"
        },
        "workspace_policy": {
          "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/authority"
        },
        "principal_authority": {
          "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/authority"
        },
        "capability_maximum": {
          "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/authority"
        },
        "operation_risk_policy": {
          "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/authority"
        }
      }
    },
    "effective_authority": {
      "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/authority"
    },
    "decision": {
      "type": "string",
      "enum": [
        "authorized",
        "approval_required",
        "denied"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "AUTHORIZED",
          "APPROVAL_REQUIRED",
          "DEPLOYMENT_DISABLED",
          "INSUFFICIENT_AUTHORITY",
          "POLICY_DENIED",
          "TARGET_NOT_ENROLLED",
          "RISK_LIMIT_EXCEEDED",
          "WORKSPACE_MISMATCH"
        ]
      }
    },
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "evaluated_at": {
      "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/timestamp"
    },
    "correlation": {
      "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/correlation"
    }
  }
}
