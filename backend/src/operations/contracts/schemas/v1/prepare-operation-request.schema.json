{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:game-agent:operations:contracts:v1:prepare-operation-request",
  "title": "Prepare Operation Request 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_contract_version",
    "capability_id",
    "proposal"
  ],
  "properties": {
    "request_contract_version": {
      "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/contract_version"
    },
    "capability_id": {
      "const": "source-control.change-proposal"
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "repository_id",
        "target_branch",
        "files"
      ],
      "properties": {
        "provider": {
          "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/identifier"
        },
        "repository_id": {
          "$ref": "urn:game-agent:operations:contracts:v1:common#/$defs/identifier"
        },
        "target_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "content_encoding",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "content_encoding": {
                "const": "utf-8"
              },
              "content": {
                "type": "string",
                "maxLength": 1000000
              }
            }
          }
        }
      }
    }
  }
}
