# Required: AWS Configuration
AWS_PROFILE=default
AWS_REGION=us-west-2

# Bedrock role models. Leave commented to use the defaults from
# backend/src/config/model_settings.py. Foundation model IDs and global./us.
# system inference profile IDs are valid. Application inference profiles over
# Claude Haiku 5.5 or Claude Sonnet 5.5 are not supported until #421: their IDs
# are opaque, so the runtime sends the earlier-generation shape (with
# temperature), which the 5.5 models reject. Use the global. system profile IDs.
# GBAW_ORCHESTRATOR_MODEL_ID=
# GBAW_SPECIALIST_MODEL_ID=
# Compatibility aliases for existing deployments (canonical role variables win):
# GBAW_BEDROCK_MODEL_ID=
# GBAW_BEDROCK_MODEL_ID_SECONDARY=

# Required: Backend URL (local development)
BACKEND_URL=http://localhost:8080

# Optional: Authentication (set to true to skip Cognito in development)
NEXT_PUBLIC_SKIP_AUTH=true

# Trusted deployment identity (server-side only)
GBAW_TENANT_ID=default-tenant
GBAW_WORKSPACE_ID=default-workspace

# Optional: Memory Configuration
GBAW_USE_BEDROCK_SESSIONS=true
GBAW_MEMORY_LONG_TERM_ENABLED=true
