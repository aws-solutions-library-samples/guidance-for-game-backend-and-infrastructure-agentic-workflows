# Environment Configuration
ENVIRONMENT=development

# AWS Configuration
# RECOMMENDED: Use AWS Profile (reads from ~/.aws/credentials)
# Run: aws configure list-profiles
AWS_PROFILE=default
AWS_REGION=us-west-2

# ALTERNATIVE: Direct credentials (NOT RECOMMENDED - use profiles instead)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_SESSION_TOKEN=your_session_token

# Bedrock Configuration
GBAW_BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-5-20250929-v1:0

# Game Agent Configuration
GBAW_USE_BEDROCK_SESSIONS=true

# Memory Configuration
# Long-term memory: Cross-session persistence (enabled by default)
GBAW_MEMORY_LONG_TERM_ENABLED=true
# Memory TTL settings
GBAW_MEMORY_SESSION_TTL_HOURS=24
GBAW_MEMORY_USER_TTL_DAYS=30
# Hard fail mode: Fail if memory unavailable (disabled by default)
GBAW_MEMORY_REQUIRED=false

# Backend Configuration (Local Development)
# Points to local AgentCore Runtime
BACKEND_URL=http://localhost:8080

# MCP Configuration
# All MCP servers use stdio transport within AgentCore Runtime
# No HTTP endpoints or external URLs needed

# Authentication Configuration (Development)
NEXT_PUBLIC_SKIP_AUTH=true
