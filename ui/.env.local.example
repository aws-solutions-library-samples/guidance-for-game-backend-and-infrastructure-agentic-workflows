# Environment Configuration
ENVIRONMENT=development

# AWS Configuration
# RECOMMENDED: Use AWS Profile (reads from ~/.aws/credentials)
# Run: aws configure list-profiles
AWS_PROFILE=default
AWS_REGION=us-west-2

# ALTERNATIVE: Direct credentials (NOT RECOMMENDED - use profiles instead)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_SESSION_TOKEN=your_session_token

# Bedrock role models
# Process environment overrides this file. Canonical role variables override
# the legacy aliases below. Application inference profile IDs are also valid.
GBAW_ORCHESTRATOR_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
GBAW_SPECIALIST_MODEL_ID=global.anthropic.claude-sonnet-4-6
# GBAW_BEDROCK_MODEL_ID=
# GBAW_BEDROCK_MODEL_ID_SECONDARY=

# Game Agent Configuration
GBAW_USE_BEDROCK_SESSIONS=true

# Memory Configuration
GBAW_MEMORY_LONG_TERM_ENABLED=true
GBAW_MEMORY_SESSION_TTL_HOURS=24
GBAW_MEMORY_USER_TTL_DAYS=30
GBAW_MEMORY_REQUIRED=false

# Backend Configuration (Local Development)
BACKEND_URL=http://localhost:8080

# MCP Configuration
# All MCP servers use stdio transport within AgentCore Runtime.

# Authentication Configuration (Development)
NEXT_PUBLIC_SKIP_AUTH=true

# Trusted deployment identity (server-side only)
GBAW_TENANT_ID=default-tenant
GBAW_WORKSPACE_ID=default-workspace
