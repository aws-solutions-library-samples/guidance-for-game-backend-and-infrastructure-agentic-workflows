{
  "$comment": "Shared parity corpus for the inline-chart contract (issue #255). Consumed by BOTH the Python validator test (backend/tests/unit/test_chart_directive_unit.py) and the TypeScript validator test (ui/src/__tests__/components/charts/chartContract.test.ts). It pins that the backend (build_chart_spec) and frontend (validateChartSpec) validators agree on the exact same decision for every case: optional nulls, the Unicode length metric, out-of-range and huge integer values, and the raw payload size boundary. A string value may be given literally or via a {\"$str\":{\"char\":\"X\",\"count\":N}} directive that both loaders expand to `char` repeated `count` times. This keeps astral (non-BMP) characters and exact boundary lengths compact and unambiguous: `char` is one Unicode code point but two UTF-16 code units, so these cases prove both sides measure length in code points, not UTF-16 units.",
  "lengthMetric": "unicode-code-points",
  "bounds": {
    "MAX_POINTS": 366,
    "MAX_SERIES": 8,
    "MAX_LABEL_LENGTH": 120,
    "MAX_TEXT_LENGTH": 280,
    "MAX_ABS_VALUE": 1000000000000,
    "MAX_RAW_PAYLOAD_CHARS": 24000
  },
  "astralChar": "𝔘",
  "specCases": [
    {
      "name": "valid-line-baseline",
      "accept": true,
      "spec": {
        "type": "line", "version": "1.0", "title": "GameLift spend", "summary": "Up.", "unit": "USD",
        "x": { "label": "Month", "values": ["Jun", "Jul", "Aug"] },
        "y": { "label": "USD" },
        "series": [{ "name": "GameLift", "values": [1204, 1521, 1880] }]
      }
    },
    {
      "name": "omitted-optionals-accepted",
      "accept": true,
      "spec": { "type": "bar", "x": { "values": ["a", "b"] }, "series": [{ "name": "s", "values": [1, 2] }] }
    },
    {
      "name": "empty-y-object-accepted",
      "accept": true,
      "spec": { "type": "bar", "x": { "values": ["a"] }, "y": {}, "series": [{ "name": "s", "values": [1] }] }
